@model EditSenderAccountViewModel
@{
    ViewData["Title"] = "Edit Sender Account";
}

<div class="max-w-lg mx-auto mt-10">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Edit Sender Account</h1>
            <p class="text-gray-500 text-sm mt-1">Update sender account details</p>
        </div>

        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg p-3"></div>

            <div>
                <label asp-for="FromName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="FromName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" />
                <span asp-validation-for="FromName" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div>
                <label asp-for="FromEmail" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="FromEmail" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" autocomplete="off" />
                <span asp-validation-for="FromEmail" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div>
                <label asp-for="ApiKey" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="ApiKey" type="password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Leave blank to keep current key" autocomplete="new-password" />
                <span asp-validation-for="ApiKey" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div>
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input asp-for="IsActive" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                    Active
                </label>
            </div>

            <div class="flex items-center space-x-3 pt-2">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-lg transition-colors focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Save Changes
                </button>
                <a href="/SenderAccounts" class="text-gray-600 hover:text-gray-800 font-medium text-sm transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>